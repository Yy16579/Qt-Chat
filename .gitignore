.vscode/
.idea/
.clangd/

# ===== 数据库文件（本地聊天记录含隐私，绝不提交）=====
# msg_<empID>.db：SQLite 本地会话仓库；-shm/-wal 为开启 WAL 模式后的伴随文件
*.db
*.db-shm
*.db-wal

# ===== 配置文件（含数据库密码等敏感信息，不提交） =====
config/config.ini
QtQQ/config/config.ini
QtQQ_Server/config/config.ini

# ===== 日志 =====
*.log

