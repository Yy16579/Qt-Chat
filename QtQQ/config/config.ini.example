; ============================================================
; QtQQ 客户端配置文件模板
; ------------------------------------------------------------
; 使用说明：
;   1. 复制本文件并重命名为 config.ini
;   2. 修改为实际的数据库和服务器参数
;   3. 运行时由 CommonUtils::getConfigPath() 定位并读取
; ============================================================

[Tcp]
; 服务端 TCP 监听地址
host=127.0.0.1
; 服务端 TCP 监听端口
port=6666
